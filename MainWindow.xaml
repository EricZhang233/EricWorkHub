<Window x:Class="EricWorkHub.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EricWorkHub"
    Closed="Window_Closed" Title="EricWorkHub">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBarGrid" Background="Transparent" Canvas.ZIndex="1000" AllowDrop="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="TitleBarDragRegion" Grid.Column="0" Grid.ColumnSpan="2" Background="Transparent" Padding="16,0,20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                    <Image x:Name="TitleBarIcon" Width="32" Height="32" Stretch="Uniform"/>
                    <TextBlock x:Name="TitleBarText" Text="EricWorkHub" VerticalAlignment="Center" Style="{ThemeResource BaseTextBlockStyle}" FontSize="18"/>
                </StackPanel>
            </Grid>
            <StackPanel x:Name="TitleBarActionsPanel" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,0">
                <Button x:Name="BtnMore" Style="{StaticResource TitleBarButtonStyle}" ToolTipService.ToolTip="{x:Bind local:Text.T('More')}" AutomationProperties.Name="{x:Bind local:Text.T('More')}">
                    <FontIcon Glyph="&#xE712;" FontSize="16"/>
                    <Button.Flyout>
                        <MenuFlyout x:Name="MoreMenuFlyout" Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="{x:Bind local:Text.T('OpenLogs')}" Click="OpenLogsButton_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="{x:Bind local:Text.T('Project')}" Click="ProjectLink_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE80F;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem Text="{x:Bind local:Text.T('Releases')}" Click="ReleasesLink_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81C;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Click="ProjectLink_Click" AutomationProperties.Name="{x:Bind local:Text.T('About')}">
                                <MenuFlyoutItem.Template>
                                    <ControlTemplate>
                                        <Grid Padding="12,8" Background="Transparent">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Width="40" Height="40" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}" VerticalAlignment="Top" Margin="0,0,10,0">
                                                <Image Stretch="Uniform" Margin="4" Loaded="MenuAuthorIcon_Loaded"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="EricWorkHub" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Loaded="MenuVersionText_Loaded"/>
                                                <TextBlock x:Name="AuthorText" Loaded="AuthorText_Loaded" FontSize="10" Margin="0,2,0,0" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </ControlTemplate>
                                </MenuFlyoutItem.Template>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,24,4" Spacing="4" Opacity="0.6">
                <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="10" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
        <InfoBar x:Name="Notification" Grid.Row="1" Margin="20,0,20,8" IsOpen="False" IsClosable="True">
            <InfoBar.ActionButton><Button Content="{x:Bind local:Text.T('ViewLogs')}" Click="OpenLogsButton_Click"/></InfoBar.ActionButton>
        </InfoBar>
        <Grid Grid.Row="2" Padding="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="220" MinWidth="180" MaxWidth="400"/>
                <ColumnDefinition Width="*" MinWidth="280"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="{x:Bind local:Text.T('Apps')}" FontSize="20" FontWeight="SemiBold" Margin="12,0,0,12"/>
                <ListView x:Name="OfficeList" Grid.Row="1" ItemsSource="{x:Bind OfficeApps}" SelectionMode="None"
                    IsItemClickEnabled="True" ItemClick="OfficeList_ItemClick" Background="Transparent">
                    <ListView.ItemContainerTransitions><TransitionCollection/></ListView.ItemContainerTransitions>
                    <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView"/></ItemsPanelTemplate></ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Margin" Value="0,0,0,4"/>
                            <Setter Property="Padding" Value="4"/>
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:OfficeAppItem">
                            <Grid Height="56" ColumnSpacing="12">
                                <ToolTipService.ToolTip>
                                    <ToolTip>
                                        <TextBlock Text="{x:Bind ToolTipText, Mode=OneWay}" TextWrapping="Wrap" MaxWidth="320"/>
                                    </ToolTip>
                                </ToolTipService.ToolTip>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid Width="48" Height="48">
                                    <FontIcon Glyph="{x:Bind PlaceholderGlyph}" FontSize="28" Opacity="0.2" Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}"/>
                                    <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="Uniform" Width="44" Height="44"/>
                                    <ProgressRing Width="24" Height="24" IsActive="{x:Bind IsBusy, Mode=OneWay}"/>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind Description, Mode=OneWay}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="AppsEmpty" Grid.Row="1" Text="{x:Bind local:Text.T('AppsEmpty')}" TextWrapping="Wrap" Margin="12,24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>
            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                    <TextBlock Text="{x:Bind local:Text.T('Recent')}" FontSize="20" FontWeight="SemiBold"/>
                    <ProgressRing x:Name="BusyIndicator" Width="16" Height="16" IsActive="False"/>
                </StackPanel>
                <local:ResizableDocumentPanel x:Name="DocumentPanel" Grid.Row="1" Background="Transparent">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                    <Grid>
                        <ListView x:Name="RecentList" ItemsSource="{x:Bind RecentItems}" SelectionMode="None" IsItemClickEnabled="True"
                            ItemClick="RecentList_ItemClick" ContainerContentChanging="RecentList_ContainerContentChanging" Background="Transparent">
                            <ListView.ItemContainerTransitions><TransitionCollection/></ListView.ItemContainerTransitions>
                            <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView"/></ItemsPanelTemplate></ListView.ItemsPanel>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:RecentItemViewModel">
                                    <Grid Padding="12" ColumnSpacing="12" ToolTipService.ToolTip="{x:Bind DisplayLocation, Mode=OneWay}" ContextRequested="Document_ContextRequested">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid Width="40" Height="40">
                                            <FontIcon Glyph="&#xE8A5;" FontSize="24" Opacity="0.25" Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}"/>
                                            <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="Uniform"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind DisplayLocation, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{x:Bind TimestampText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
                </local:ResizableDocumentPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
